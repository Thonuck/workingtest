{% extends "base.html.jinja" %}
{% from "generic_details.html.jinja" import generic_details %}

{% block content %}
{% set edit_data = {
    "title": "Benutzer bearbeiten",
    "fields": [
        {"name": "username", "label": "Benutzername",               "value": user.username, "type": "text",     "required": true},
        {"name": "role",     "label": "Rolle",                       "value": user.role,     "type": "select",
         "options": [["guest", "Guest"], ["helper", "Helper"], ["organizer", "Organizer"], ["admin", "Admin"]],
         "required": true},
        {"name": "password", "label": "Neues Passwort (optional)",  "value": "",            "type": "password", "placeholder": "Neues Passwort"}
    ],
    "buttons": [
        {"type": "submit", "label": "Speichern",  "style": "primary"},
        {"type": "link",   "label": "Abbrechen",  "url": url_for('users.list_users'), "style": "secondary"}
    ]
} %}
{{ generic_details(edit_data, edit=true) }}
{% endblock %}