{#   GENERIC DETAILS / EDIT TEMPLATE                                          #}
{#                                                                              #}
{# generic_details(data, edit=false, show_flash=true)                          #}
{#                                                                              #}
{# data = {                                                                     #}
{#   "title": "...",           (optional) card heading                         #}
{#   "form_action": "...",     (optional) form action URL for edit mode        #}
{#   "fields": [                                                                #}
{#     {                                                                        #}
{#       "name":        "...",   form field name / detail key                  #}
{#       "label":       "...",   human-readable label                          #}
{#       "value":       "...",   current value                                 #}
{#       "type":        "text|password|email|number|select|textarea",          #}
{#       "options":     [["value", "Display Text"], ...],  (select only)       #}
{#       "required":    false,   (optional)                                    #}
{#       "placeholder": ""       (optional)                                    #}
{#     }, ...                                                                   #}
{#   ],                                                                         #}
{#   "buttons": [                                                               #}
{#     {                                                                        #}
{#       "type":    "link|submit|form",                                         #}
{#       "label":   "...",                                                      #}
{#       "url":     "...",    (link and form types)                             #}
{#       "style":   "primary|secondary|danger|...",  (Bootstrap btn style)     #}
{#       "confirm": "..."     (optional, form type only – confirmation dialog) #}
{#     }, ...                                                                   #}
{#   ]                                                                          #}
{# }                                                                            #}
{#                                                                              #}
{# edit=false  →  read-only detail view                                        #}
{# edit=true   →  editable form view with current values pre-filled            #}
{#                                                                              #}
{# Notes:                                                                       #}
{#   - "textarea" fields render their value between <textarea> tags (not via   #}
{#     a value= attribute), which correctly handles newlines and HTML entities. #}
{#   - Button type "form" (standalone POST form with optional confirm dialog)  #}
{#     is only rendered in read-only mode (edit=false).  In edit mode the      #}
{#     outer <form> already handles POST; use type "submit" there instead.     #}


{% macro generic_details(data, edit=false, show_flash=true) %}
<div class="row mt-5">
    <div class="col-12 col-sm-10 col-md-8 col-lg-6 offset-sm-1 offset-md-2 offset-lg-3">
        <div class="card">
            <div class="card-body">

                {% if data.title %}
                <h1 class="card-title">{{ data.title }}</h1>
                {% endif %}

                {% if show_flash %}
                {% with messages = get_flashed_messages(with_categories=true) %}
                  {% if messages %}
                    {% for category, message in messages %}
                      <div class="alert alert-{{ category }}">{{ message }}</div>
                    {% endfor %}
                  {% endif %}
                {% endwith %}
                {% endif %}

                {% if edit %}
                {# ── Edit / New: render a form with pre-filled inputs ── #}
                <form method="POST" {% if data.form_action %}action="{{ data.form_action }}"{% endif %}>
                    {% for field in data.fields %}

                        {% if field.type == 'select' %}
                        <div class="form-group mb-3">
                            <label>{{ field.label }}</label>
                            <select name="{{ field.name }}" class="form-control"
                                    {% if field.required %}required{% endif %}>
                                {% for opt_value, opt_text in field.options %}
                                <option value="{{ opt_value }}"
                                    {% if opt_value == field.value %}selected{% endif %}>
                                    {{ opt_text }}
                                </option>
                                {% endfor %}
                            </select>
                        </div>

                        {% elif field.type == 'textarea' %}
                        <div class="form-group mb-3">
                            {% if field.label %}<label>{{ field.label }}</label>{% endif %}
                            <textarea name="{{ field.name }}" class="form-control"
                                      {% if field.placeholder %}placeholder="{{ field.placeholder }}"{% endif %}
                                      {% if field.required %}required{% endif %}>{{ field.value|default('') }}</textarea>
                        </div>

                        {% else %}
                        <div class="form-group mb-3">
                            {% if field.label %}<label>{{ field.label }}</label>{% endif %}
                            <input
                                type="{{ field.type|default('text') }}"
                                name="{{ field.name }}"
                                class="form-control"
                                {% if field.placeholder %}placeholder="{{ field.placeholder }}"{% endif %}
                                {% if field.value %}value="{{ field.value }}"{% endif %}
                                {% if field.required %}required{% endif %}
                            >
                        </div>
                        {% endif %}

                    {% endfor %}

                    <div class="d-flex gap-2 mt-3">
                        {% for btn in data.buttons %}
                            {% if btn.type == 'submit' %}
                            <button type="submit" class="btn btn-{{ btn.style|default('primary') }}">
                                {{ btn.label }}
                            </button>
                            {% elif btn.type == 'link' %}
                            <a href="{{ btn.url }}" class="btn btn-{{ btn.style|default('secondary') }}">
                                {{ btn.label }}
                            </a>
                            {% endif %}
                        {% endfor %}
                    </div>
                </form>

                {% else %}
                {# ── Detail / Read-only: render field values as a definition list ── #}
                <dl>
                    {% for field in data.fields %}
                    <dt>{{ field.label }}</dt>
                    <dd>{{ field.value }}</dd>
                    {% endfor %}
                </dl>

                <div class="d-flex gap-2 mt-3">
                    {% for btn in data.buttons %}
                        {% if btn.type == 'link' %}
                        <a href="{{ btn.url }}" class="btn btn-{{ btn.style|default('info') }}">
                            {{ btn.label }}
                        </a>
                        {% elif btn.type == 'form' %}
                        <form method="POST" action="{{ btn.url }}" style="display:inline;"
                              {% if btn.confirm %}onsubmit="return confirm('{{ btn.confirm }}');"{% endif %}>
                            <button type="submit" class="btn btn-{{ btn.style|default('danger') }}">
                                {{ btn.label }}
                            </button>
                        </form>
                        {% endif %}
                    {% endfor %}
                </div>
                {% endif %}

            </div>
        </div>
    </div>
</div>
{% endmacro %}
